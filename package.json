{
  "name": "vetroscope-mcp",
  "version": "0.4.0",
  "description": "Read-only Model Context Protocol server for Vetroscope — gives LLMs context on your tracked time, projects, and goals from your local Vetroscope SQLite database.",
  "license": "MIT",
  "author": "Jacob Rankin <jake@vetroscope.com> (https://rankin.works)",
  "homepage": "https://github.com/rankin-works/Vetroscope-MCP",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rankin-works/Vetroscope-MCP.git"
  },
  "bugs": {
    "url": "https://github.com/rankin-works/Vetroscope-MCP/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "vetroscope",
    "time-tracking",
    "claude",
    "claude-desktop",
    "claude-code",
    "chatgpt"
  ],
  "type": "module",
  "bin": {
    "vetroscope-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "assets",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "better-sqlite3": "^11.7.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2"
  }
}
